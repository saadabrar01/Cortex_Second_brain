# Database (PostgreSQL with asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/seconed_brain

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS - Frontend origins allowed to access this API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]