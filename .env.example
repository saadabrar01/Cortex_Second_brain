# Base URL of your FastAPI backend (include the /api prefix if your router uses one)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# When true (default), any service call that fails to reach the backend falls
# back to local mock data so the UI stays demoable while the backend is down
# or still being built. Set to false once your FastAPI endpoints are live.
NEXT_PUBLIC_USE_MOCK_FALLBACK=true
